# Add these values in Vercel Project Settings, or copy this template to a
# deployment-specific secret store. Never commit real values or PEM contents.

# Required: use the provider's pooled web URL when available. DATABASE_URL is
# the fallback; DATABASE_WORKER_URL is optional for a separate worker.
DATABASE_WEB_URL=postgresql://user:password@host/database
DATABASE_WORKER_URL=
DATABASE_URL=
DATABASE_POOL_MAX=1

# Preferred for Vercel: paste the complete provider PEM here. Literal \n
# escapes are normalized. Do not use a Windows DATABASE_CA_CERT_PATH in Vercel.
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=

APP_URL=https://connect-sable-two.vercel.app
CRON_SECRET=
SECURITY_AUDIT_SECRET=
TRUST_PROXY_HEADERS=false

# Keep JEV disabled until its separate provider credentials and smoke test are
# complete. JEV is optional and is not required for authentication.
JEV_MODE=off
JEV_PROVIDER=vercel
AI_GATEWAY_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=
JEV_USER_KEY_ENCRYPTION_SECRET=
TYPESAFE_API_KEY=
JEV_REQUEST_TIMEOUT_MS=10000
JEV_MAX_RETRIES=2
JEV_MAX_ATTEMPTS=5
JEV_BATCH_SIZE=5
