{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "subsystem": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["path", "subsystem", "sha256"],
        "additionalProperties": false
      }
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string"
          },
          "entrypoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "string"
          }
        },
        "required": ["root", "entrypoints", "tests"],
        "additionalProperties": false
      }
    },
    "subsystems": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "roots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "entrypoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "docs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "roots",
          "entrypoints",
          "tests",
          "docs",
          "depends_on",
          "review"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "base_commit", "sources"],
  "additionalProperties": false
}
