# Copy to .env.local for local development. Never commit the copied file.

# Local PostgreSQL. DATABASE_WEB_URL and DATABASE_WORKER_URL may be left empty;
# both roles fall back to DATABASE_URL.
DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar
DATABASE_WEB_URL=
DATABASE_WORKER_URL=
DATABASE_POOL_MAX=1
DATABASE_CA_CERT_PATH=
DATABASE_CA_CERT=
POSTGRES_PASSWORD=jobradar

APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-local-random-secret-of-at-least-24-characters
SECURITY_AUDIT_SECRET=replace-with-a-local-random-secret-of-at-least-32-characters
TRUST_PROXY_HEADERS=false

# Keep model work disabled locally unless explicitly configured.
JEV_MODE=off
JEV_PROVIDER=vercel
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
JEV_BASE_URL=
TYPESAFE_API_KEY=
JEV_REQUEST_TIMEOUT_MS=10000
JEV_MAX_RETRIES=2
JEV_MAX_ATTEMPTS=5
JEV_BATCH_SIZE=5
