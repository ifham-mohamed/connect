# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Required: workspace data, user accounts, sessions, jobs, and JEV results.
DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar
# Optional future split: transaction-pooled web URL and direct worker URL.
DATABASE_WEB_URL=
DATABASE_WORKER_URL=
# Optional: keep this low for hosted PostgreSQL connection limits.
DATABASE_POOL_MAX=1
# Docker Compose database only; ignored when DATABASE_URL points to Aiven.
POSTGRES_PASSWORD=jobradar
# Aiven TLS: use the inline PEM in DATABASE_CA_CERT for Vercel and containers.
# A local file path is supported only when the file exists at runtime.
DATABASE_CA_CERT_PATH=
# Paste the complete PEM, or use literal \\n escapes when the environment UI does not preserve line breaks.
DATABASE_CA_CERT=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Required: exact browser origin. Use the deployed HTTPS origin in production.
APP_URL=http://localhost:3000
# Required only when /api/cron triggers collection. Use at least 24 random chars.
CRON_SECRET=replace-with-another-long-random-secret
# Required in production: HMAC key for privacy-preserving IP and device hashes.
# Generate independently from every other secret (at least 32 random bytes).
SECURITY_AUDIT_SECRET=
# Enable only behind a proxy that overwrites forwarded-IP headers.
TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# JEV job intelligence
# -----------------------------------------------------------------------------
# Keep off until `npm run jev:smoke` succeeds; use shadow for safe evaluation.
JEV_MODE=off
# Recommended transport for the key created in Vercel AI Gateway.
JEV_PROVIDER=vercel
# Required when JEV_PROVIDER=vercel and JEV_MODE is shadow or assisted.
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
# Optional override; normally leave blank to use the built-in gateway endpoint.
JEV_BASE_URL=
# Optional alternative: used only when JEV_PROVIDER=typesafe.
TYPESAFE_API_KEY=
# Optional worker tuning; these defaults are safe starting values.
JEV_USER_KEY_ENCRYPTION_SECRET=
JEV_REQUEST_TIMEOUT_MS=10000
JEV_MAX_RETRIES=2
JEV_MAX_ATTEMPTS=5
JEV_BATCH_SIZE=5
# Workspace request/token caps are stored in PostgreSQL and managed by the
# owner in Settings. Keep paid overage and purchased credits disabled in the
# Vercel AI Gateway account; provider 402/429 responses pause local requests.
