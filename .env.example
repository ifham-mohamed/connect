# Leave DATABASE_URL empty to explore the clearly labeled browser-only demo.
DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar
POSTGRES_PASSWORD=jobradar
# Generate long random values before deploying. Admin access protects all writes.
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-another-long-random-secret
APP_URL=http://localhost:3000
# For Aiven: use the exact service URL and replace its password placeholder.
# Keep certificate verification enabled; download the CA from your Aiven service.
DATABASE_CA_CERT_PATH=
# Alternatively supply the PEM certificate (escaped newlines supported).
DATABASE_CA_CERT=
