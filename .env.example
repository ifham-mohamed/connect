# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Required: workspace data, user accounts, sessions, jobs, and JEV results.
DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar
# Optional: keep this low for hosted PostgreSQL connection limits.
DATABASE_POOL_MAX=2
# Docker Compose database only; ignored when DATABASE_URL points to Aiven.
POSTGRES_PASSWORD=jobradar
# Aiven TLS: use the downloaded CA file path. Leave blank for local PostgreSQL.
DATABASE_CA_CERT_PATH=
# Alternative to DATABASE_CA_CERT_PATH: inline PEM with escaped newlines.
DATABASE_CA_CERT=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Required: exact browser origin. Use the deployed HTTPS origin in production.
APP_URL=http://localhost:3000
# Required only when /api/cron triggers collection. Use at least 24 random chars.
CRON_SECRET=replace-with-another-long-random-secret

# -----------------------------------------------------------------------------
# JEV job intelligence
# -----------------------------------------------------------------------------
# Keep off until `npm run jev:smoke` succeeds; use shadow for safe evaluation.
JEV_MODE=off
# Recommended transport for the key created in Vercel AI Gateway.
JEV_PROVIDER=vercel
# Required when JEV_PROVIDER=vercel and JEV_MODE is shadow or assisted.
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
# Optional override; normally leave blank to use the built-in gateway endpoint.
JEV_BASE_URL=
# Optional alternative: used only when JEV_PROVIDER=typesafe.
TYPESAFE_API_KEY=
# Optional worker tuning; these defaults are safe starting values.
JEV_REQUEST_TIMEOUT_MS=10000
JEV_MAX_RETRIES=2
JEV_MAX_ATTEMPTS=5
JEV_BATCH_SIZE=5
