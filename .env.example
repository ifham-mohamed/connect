# Required for workspace data, user accounts, and sessions.
DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar
DATABASE_POOL_MAX=2
POSTGRES_PASSWORD=jobradar
# Generate a long random scheduler secret before deploying.
CRON_SECRET=replace-with-another-long-random-secret
APP_URL=http://localhost:3000
# For Aiven: use the exact service URL and replace its password placeholder.
# Keep certificate verification enabled; download the CA from your Aiven service.
DATABASE_CA_CERT_PATH=
# Alternatively supply the PEM certificate (escaped newlines supported).
DATABASE_CA_CERT=

# JEV is disabled unless explicitly enabled. Keep this key server-side.
JEV_MODE=off
# Vercel AI Gateway is the default JEV transport.
JEV_PROVIDER=vercel
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
# Optional override; the default is https://ai-gateway.vercel.sh/typesafe.
JEV_BASE_URL=
# Direct TypeSafe access remains available with JEV_PROVIDER=typesafe.
TYPESAFE_API_KEY=
JEV_REQUEST_TIMEOUT_MS=10000
JEV_MAX_RETRIES=2
JEV_MAX_ATTEMPTS=5
JEV_BATCH_SIZE=5
