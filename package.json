{
  "name": "jobradar",
  "version": "1.0.0",
  "description": "Sri Lanka and remote technology job monitoring workspace",
  "scripts": {
    "test": "vitest run",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "sync": "tsx --env-file-if-exists=.env scripts/worker.ts --once",
    "itpro:refresh": "tsx --env-file-if-exists=.env scripts/refresh-itpro.ts",
    "topjobs:refresh": "tsx --env-file-if-exists=.env scripts/refresh-topjobs.ts",
    "rooster:refresh": "tsx --env-file-if-exists=.env scripts/refresh-source.ts rooster",
    "dijital:refresh": "tsx --env-file-if-exists=.env scripts/refresh-source.ts lever dijital-team-pty-ltd",
    "jev:verify": "tsx --env-file-if-exists=.env scripts/evaluate-jev.ts",
    "jev:smoke": "tsx --env-file-if-exists=.env scripts/evaluate-jev.ts --live --limit=1",
    "jev:evaluate": "tsx --env-file-if-exists=.env scripts/evaluate-jev.ts --live",
    "jev:backfill": "tsx --env-file-if-exists=.env scripts/backfill-jev.ts",
    "jev:worker": "tsx --env-file-if-exists=.env scripts/intelligence-worker.ts",
    "jev:worker:once": "tsx --env-file-if-exists=.env scripts/intelligence-worker.ts --once",
    "jev:report": "tsx --env-file-if-exists=.env scripts/report-jev.ts",
    "jev:requirements": "tsx --env-file-if-exists=.env scripts/evaluate-requirements.ts",
    "jev:rematch:deterministic": "tsx --env-file-if-exists=.env scripts/rematch-deterministic.ts --confirm",
    "format": "prettier --write src scripts tests docs README.md",
    "db:check": "tsx --env-file-if-exists=.env scripts/check-database.ts"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@typesafe-ai/sdk": "0.6.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
